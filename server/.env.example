# ─────────────────────────────────────────────────────────────────
# MediShield AI – Server Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────────────────────────
PORT=5000

# ── MongoDB ───────────────────────────────────────────────────────
# Local:  mongodb://localhost:27017/medishield_ai
# Atlas:  mongodb+srv://<user>:<pass>@cluster.mongodb.net/medishield_ai
MONGODB_URI=mongodb://localhost:27017/medishield_ai

# ── Email (Nodemailer) ────────────────────────────────────────────
# Gmail setup:
#   1. Enable 2-Factor Authentication on your Google account
#   2. Go to Google Account → Security → App Passwords
#   3. Generate an App Password for "Mail" and paste it as EMAIL_PASS
#
# Other providers: set EMAIL_HOST and EMAIL_PORT accordingly
# (e.g. SendGrid: host=smtp.sendgrid.net port=587 user=apikey pass=<api_key>)

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-gmail@gmail.com
EMAIL_PASS=your-16-char-app-password
EMAIL_FROM="MediShield AI" <noreply@medishield.ai>

# Fallback recipient if a doctor has no email on file
ADMIN_NOTIFY_EMAIL=admin@medishield.ai

# ── Frontend URL (used in email "View Dashboard" link) ───────────
CLIENT_URL=http://localhost:3000

# ── Anthropic API (NLP Symptom Analysis) ─────────────────────────
# Get your key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...
